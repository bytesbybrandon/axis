---
import { href } from '../lib/site';
import { REPO } from '../lib/catalog';
---
<header class="nav">
  <div class="container nav__row">
    <a class="wordmark" href={href()} aria-label="axis, home">axis</a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        <li class="nav__opt"><a href={href('#list')}>Roster</a></li>
        <li><a href={REPO}>GitHub</a></li>
        <li class="nav__search">
          <button class="navkey" type="button" data-palette-open aria-label="Find an AXI">
            <span>Find</span> <kbd data-mod>Ctrl</kbd> <kbd>K</kbd>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
