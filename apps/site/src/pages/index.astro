---
import Base from '../layouts/Base.astro';
import Output from '../components/Output.astro';
import { allTags, loadCatalog } from '../lib/catalog';
import { suggestedCommands } from '../lib/commands';
import { highlight } from '../lib/highlight';
import { registryDoc, toJson, toToon } from '../lib/docs';
import { requestUrl } from '../lib/links';
import { absolute, href } from '../lib/site';

const axis = loadCatalog();
const tags = allTags(axis);
const pageUrl = (p: string) => absolute(p, Astro.site);
const doc = registryDoc(axis, pageUrl);
const json = toJson(doc);
const toon = toToon(doc).trimEnd();
const saved = Math.round((1 - toon.length / json.length) * 100);
const fmt = new Intl.NumberFormat('en-US');

// The hero plays tttui-axi with its real code. Without it (or without scripting) it shows captured output.
const featured = axis.find((a) => a.name === 'tttui-axi' && a.home) ?? axis.find((a) => a.home);
const playable = featured?.name === 'tttui-axi';
const vt = (name: string) => `vt-${name.replace(/[^a-z0-9-]/gi, '-')}`;

const sizes = axis.map((a) => ({
  a,
  lines: a.home ? a.home.text.split('\n').length : undefined,
  chars: a.home?.text.length,
  moves: a.home ? suggestedCommands(a.home.text).length : undefined,
}));
const widest = Math.max(1, ...sizes.map((s) => s.chars ?? 0));

const next = [
  featured && { verb: 'Run one', how: featured.install, copy: featured.install },
  { verb: 'Request an AXI', how: 'Name a tool your agent fights with. This opens a prefilled issue.', href: requestUrl() },
  { verb: 'Add your own', how: 'Every folder in packages/ gets a page.', href: href('#add') },
  { verb: 'Read the principles', how: 'The ten rules every AXI follows.', href: 'https://axi.md' },
].filter((n): n is NonNullable<typeof n> => Boolean(n));
---
<Base
  title="axis: command lines your agent can read"
  description="The AXIs by bytesbybrandon: agent command lines that print their state, then what to run next, when run with no arguments."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title">Command lines your agent can read.</h1>
        <p class="lead">With no arguments, each prints its state, then what to run next.</p>
        <div class="actions">
          {featured && (
            <button class="btn" type="button" data-copy={featured.install}>
              <span data-copy-label>Copy {featured.install}</span>
            </button>
          )}
          <a class="btn btn--quiet" href="#list">See the roster</a>
        </div>
      </div>

      {featured && playable && (
        <div class="well play" data-play>
          <div class="play__split">
            <div class="play__you">
              <p class="play__label">What you see</p>
              <div class="play__board" role="group" aria-label="Tic-tac-toe board">
                {Array.from({ length: 9 }, (_, i) => (
                  <button class="cell" type="button" data-cell disabled aria-label={`Cell ${i}`}></button>
                ))}
              </div>
              <fieldset class="seg play__level">
                <legend>Opponent</legend>
                <input type="radio" name="level" id="lv-easy" value="easy" checked /><label for="lv-easy">Easy</label>
                <input type="radio" name="level" id="lv-medium" value="medium" /><label for="lv-medium">Medium</label>
                <input type="radio" name="level" id="lv-unbeatable" value="unbeatable" /><label for="lv-unbeatable">Unbeatable</label>
              </fieldset>
            </div>
            <div class="play__agent">
              <p class="play__label">What an agent gets</p>
              <p class="well__cmd"><span class="well__prompt" aria-hidden="true">$</span> <code data-cmd>tttui</code></p>
              <pre class="out" data-out tabindex="0" aria-label="Output of tttui"><code set:html={highlight(featured.home!.text)} /></pre>
              <div class="play__chips" data-chips></div>
            </div>
          </div>
          <p class="well__note play__meter" data-meter>Replies appear here as you play.</p>
          <p class="well__note">This runs the real <a href={featured.repoUrl}>tttui-axi</a> code in your browser. Each click is the command an agent would type.</p>
          <p class="visually-hidden" role="status" data-live></p>
        </div>
      )}
      {featured && !playable && (
        <div class="well">
          <div class="well__panel"><Output axi={featured} /></div>
        </div>
      )}
    </div>
  </section>

  <section class="band roster" id="list" aria-labelledby="list-title">
    <div class="container">
      <div class="band__head">
        <h2 id="list-title">The roster</h2>
        <form class="filter" role="search" data-filter>
          <label class="filter__label" for="q">Search</label>
          <input id="q" class="field" type="search" name="q" autocomplete="off" placeholder="Name, tag or what it wraps" />
          {tags.length > 1 && (
            <div class="chips" role="group" aria-label="Filter by tag">
              {tags.map((t) => (
                <button class="chip" type="button" data-tag={t} aria-pressed="false">{t}</button>
              ))}
            </div>
          )}
          <p class="filter__count" role="status" data-count><span data-shown>{axis.length}</span> of {axis.length} AXIs</p>
        </form>
      </div>
      <div class="roster__grid">
        <ol class="ledger" data-ledger>
          {axis.map((a) => (
            <li class="row" data-row data-name={a.name} data-hue={a.hue} data-tags={a.tags.join(' ')} data-text={[a.name, a.description, a.wraps?.name, ...a.tags].filter(Boolean).join(' ').toLowerCase()}>
              <div class="row__main">
                <h3 class="row__name" style={`view-transition-name: ${vt(a.name)}`}><a class="row__link" href={href(`axi/${a.name}/`)}>{a.name}</a></h3>
                <p class="row__desc">{a.description}</p>
                <p class="row__meta">
                  <span class="num">v{a.version}</span>
                  <span>{a.license}</span>
                  {a.tags.map((t) => <span>{t}</span>)}
                </p>
              </div>
              <button class="copy row__copy" type="button" data-copy={a.install} aria-label={`Copy ${a.install}`}><span data-copy-label>Copy npx</span></button>
              {a.home && (
                <details class="row__out well">
                  <summary>See its bare output</summary>
                  <Output axi={a} />
                </details>
              )}
            </li>
          ))}
        </ol>
        <aside class="stage well" data-stage aria-label="Bare output of the highlighted AXI">
          {axis.filter((a) => a.home).map((a) => (
            <div class="well__panel" data-panel={a.name}>
              <Output axi={a} />
              <p class="well__note"><a href={href(`axi/${a.name}/`)}>Open {a.name}</a></p>
            </div>
          ))}
        </aside>
      </div>
      <p class="empty" data-empty hidden>0 AXIs match. <button class="linkish" type="button" data-clear>Clear the filters</button> to see all {axis.length}.</p>
    </div>
  </section>

  <section class="band" id="agents" aria-labelledby="agents-title">
    <div class="container">
      <div class="readers">
        {saved > 0 ? (
          <h2 id="agents-title"><span class="bignum num">{saved}%</span> fewer characters when an agent reads this list.</h2>
        ) : (
          <h2 id="agents-title">This list, in the form agents read.</h2>
        )}
        <div class="readers__copy">
          <p>Drag the curtain. Left is the page you read. Right is the file an agent reads, the same {axis.length} records as TOON.</p>
          <dl class="stats">
            <div><dt><a href={href('catalog.toon.txt')}>catalog.toon.txt</a></dt><dd class="num">{fmt.format(toon.length)} characters</dd></div>
            <div><dt><a href={href('catalog.json')}>catalog.json</a>, indented</dt><dd class="num">{fmt.format(json.length)} characters</dd></div>
          </dl>
        </div>
      </div>
      <div class="curtain" data-curtain style="--x: 40%">
        <ol class="curtain__page">
          {axis.map((a) => (
            <li>
              <span class="curtain__name">{a.name}</span>
              <span class="curtain__desc">{a.description}</span>
              <span class="num curtain__ver">v{a.version}</span>
            </li>
          ))}
        </ol>
        <div class="curtain__agent well">
          <pre class="out" tabindex="0" aria-label="The roster as TOON"><code set:html={highlight(toon)} /></pre>
        </div>
        <input class="curtain__range" type="range" min="0" max="100" value="40" data-rest="40" aria-label="Drag to move the curtain between the page and the agent copy" />
        <span class="curtain__handle" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="band" id="output" aria-labelledby="output-title">
    <div class="container">
      <h2 id="output-title">What each prints with no arguments</h2>
      <table class="sizes">
        <thead>
          <tr><th scope="col">AXI</th><th scope="col" class="num">Version</th><th scope="col" class="num">Lines</th><th scope="col">Characters</th><th scope="col" class="num">Next moves</th></tr>
        </thead>
        <tbody>
          {sizes.map(({ a, lines, chars, moves }) => (
            <tr style={`--row-hue: ${a.hue}`}>
              <th scope="row" data-label="AXI"><a href={href(`axi/${a.name}/`)}>{a.name}</a></th>
              <td class="num" data-label="Version">{a.version}</td>
              <td class="num" data-label="Lines">{lines ?? 'not captured'}</td>
              <td class="sizes__chars" data-label="Characters">
                {chars !== undefined ? (
                  <div class="sizes__cell">
                    <span class="bar" style={`--w: ${(chars / widest) * 100}%`} aria-hidden="true"></span>
                    <span class="num">{fmt.format(chars)}</span>
                  </div>
                ) : 'not captured'}
              </td>
              <td class="num" data-label="Next moves">{moves ?? 'not captured'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">Counted on the captured output. A next move is a command the output tells the agent to run.</p>
    </div>
  </section>

  <section class="band band--tint" id="add" aria-labelledby="add-title">
    <div class="container add">
      <h2 id="add-title">Every folder in packages/ gets a page.</h2>
      <ol class="steps">
        <li><span>Put the package in <code>packages/&lt;name&gt;</code> with its own <code>package.json</code> and README.</span></li>
        <li><span>Run <code>pnpm --filter @axis/site capture &lt;name&gt;</code> to record what it prints bare.</span></li>
        <li><span>Optionally tag it in <code>apps/site/src/data/meta.json</code>.</span></li>
        <li><span>Open a pull request. Merging to main publishes this site.</span></li>
      </ol>
    </div>
  </section>

  <section class="band next" aria-labelledby="next-title">
    <div class="container">
      <h2 id="next-title" class="next__key"><code>next[{next.length}]:</code></h2>
      <ul class="next__list">
        {next.map((n) => (
          <li>
            {n.copy ? (
              <button class="next__row" type="button" data-copy={n.copy}>
                <span class="next__verb">{n.verb}</span>
                <span class="next__how"><code>{n.how}</code> <span data-copy-label>Copy</span></span>
              </button>
            ) : (
              <a class="next__row" href={n.href}>
                <span class="next__verb">{n.verb}</span>
                <span class="next__how">{n.how}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
